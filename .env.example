# Copy to ".env" (repo root, next to docker-compose.local.yml) and fill in real values.
# ".env" is gitignored — never commit it.
#
# Generate strong values:  python -c "import secrets; print(secrets.token_urlsafe(24))"

LEADGEN_DB_PASS=change_me_postgres_password
LEADGEN_REDIS_PASS=change_me_redis_password
CRAWL4AI_TOKEN=change_me_crawl4ai_token

# These feed server/leads_api.py when you run it locally:
#   DB_PASS=%LEADGEN_DB_PASS% python server/leads_api.py   (Windows)
#   DB_PASS=$LEADGEN_DB_PASS python server/leads_api.py    (Linux/Mac)
